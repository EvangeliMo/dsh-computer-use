{
  "name": "dsh-computer-use-mode",
  "version": "0.1.2",
  "type": "commonjs",
  "description": "Computer-use mode for DeepSeek Harness: native-resolution screen capture plus mouse, keyboard and window control, for operating software that has no agent-facing integration.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "computer-use",
    "screen-capture",
    "gui-automation"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvangeliMo/dsh-computer-use-mode.git"
  },
  "homepage": "https://github.com/EvangeliMo/dsh-computer-use-mode#readme",
  "bugs": {
    "url": "https://github.com/EvangeliMo/dsh-computer-use-mode/issues"
  },
  "scripts": {
    "test:native": "node scripts/test-native.cjs",
    "test:plugin": "node scripts/test-plugin.cjs",
    "test": "node scripts/test-native.cjs && node scripts/test-plugin.cjs"
  },
  "license": "MIT"
}
